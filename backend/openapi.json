                "$ref": "#/components/schemas/VerifyInput"
              }
            }
          }
        },
        "description": "Confirm email ownership using a one-time token or challenge_id plus six-digit code. Codes expire in 10 minutes; five wrong attempts invalidate the challenge. This does not verify record contents."
      }
    },
