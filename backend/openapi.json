        "summary": "Confirm email ownership",
        "operationId": "post_api_v1_email_verifications_confirm",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "JSON error response",
            "content": {
              "application/json": {
                "schema": {
