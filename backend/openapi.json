{
  "openapi": "3.1.0",
  "info": {
    "title": "Private Records API",
    "version": "1.0.0",
    "description": "Standalone local service. All records are unverified. Internal sharing links have no government validity. Email messages use a development outbox; no email is sent."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "security": [
    {
      "adminBearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "get_healthz",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "JSON error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/people": {
      "get": {
        "summary": "List people",
        "operationId": "get_api_v1_people",
        "responses": {
          "200": {
            "description": "Object containing items, total, page, page_size and disclaimer."
          },
          "default": {
            "description": "JSON error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Admin-only name, email, passport or phone search"
          },
          {
            "name": "field",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "name",
                "email",
                "passport",
                "phone"
              ],
              "default": "all"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "updated_at",
                "name",
                "email",
                "nationality",
                "phone_number",
                "passport_number"
              ],
              "default": "created_at"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "verification",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "verified",
                "pending"
              ],
              "default": "all"
            }
          },
          {
            "name": "nationality",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact nationality filter"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "25 results per page; out-of-range pages are clamped."
          }
        ]
      },
      "post": {
        "summary": "Create person",
        "operationId": "post_api_v1_people",
        "responses": {
          "201": {
            "description": "Success"
          },
          "default": {
            "description": "JSON error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonInput"
              }
            }
          }
        }
      }
    },
