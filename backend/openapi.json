    "/api/v1/reports": {
      "get": {
        "summary": "Admin dashboard additions by calendar month",
        "operationId": "get_api_v1_reports",
        "description": "Asia/Kolkata calendar months, current partial month included. Additions include later-deleted records; updates are excluded. Historical records fall back to CreatedAt when no creation audit event exists.",
        "parameters": [
          {
            "name": "months",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                3,
                6,
                12
              ],
              "default": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current total, this_month, three_months, six_months, twelve_months, selected_months, selected_added, selected_deleted, monthly counts, from, through and timezone."
          },
          "401": {
            "description": "Admin bearer token required"
          }
        }
      }
    },
    "/api/v1/outbox/{id}/send": {
      "post": {
        "summary": "Send a queued Private Records email using configured SMTP",
        "operationId": "sendOutboxEmail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SMTP accepted; email_sent is true"
          },
          "404": {
            "description": "Message missing"
          },
          "422": {
            "description": "SMTP unavailable, inactive message, or delivery failure"
          }
        }
      }
    },
    "/api/v1/shared/{token}/pdf": {
      "get": {
        "summary": "Download an unverified private-record PDF using an active sharing token",
        "operationId": "downloadSharedPrivatePDF",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Invalid, expired, revoked or deleted sharing link"
          }
        }
      }
    },
    "/api/v1/people/lookup": {
      "post": {
        "summary": "Find a private record by internal ID and date of birth (admin only)",
        "operationId": "lookup_person",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "date_of_birth"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250
                  },
                  "date_of_birth": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching person record"
          },
          "400": {
            "description": "Malformed JSON or unknown fields"
          },
          "401": {
            "description": "Administrator authentication required"
          },
          "404": {
            "description": "No matching record"
          },
          "422": {
            "description": "Missing or invalid ID or date of birth"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PersonInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "first_name"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 250
          },
          "last_name": {
            "type": "string",
            "maxLength": 250
          },
          "email": {
            "type": "string",
            "maxLength": 250
          },
          "date_of_birth": {
            "type": "string",
            "maxLength": 250,
            "description": "YYYY-MM-DD or empty string"
          },
          "nationality": {
            "type": "string",
            "maxLength": 250
          },
          "passport_number": {
            "type": "string",
            "maxLength": 250
          },
          "recorded_status": {
            "type": "string",
            "maxLength": 250,
            "description": "User-supplied, unverified record value; not a government determination."
          },
          "accompanied_by": {
            "type": "string",
            "maxLength": 250
          },
          "valid_from": {
            "type": "string",
            "maxLength": 250,
            "description": "YYYY-MM-DD or empty string"
          },
          "valid_until": {
            "type": "string",
            "maxLength": 250,
            "description": "YYYY-MM-DD or empty string"
          },
          "entries_allowed": {
            "type": "string",
            "description": "Digits only (for example 1, 44, 777), Multiple (case-insensitive), or empty. Multiple is stored with this capitalization.",
            "maxLength": 250
          },
          "national_insurance_number": {
            "type": "string",
            "maxLength": 250
          },
          "phone_number": {
            "type": "string",
            "description": "Optional phone number containing 7\u201315 digits; +, spaces, parentheses, dots and dashes are accepted."
          }
        }
      },
      "PersonPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 250
          },
          "last_name": {
            "type": "string",
            "maxLength": 250
          },
          "email": {
            "type": "string",
            "maxLength": 250
          },
          "date_of_birth": {
            "type": "string",
            "maxLength": 250,
            "description": "YYYY-MM-DD or empty string"
          },
          "nationality": {
            "type": "string",
            "maxLength": 250
          },
          "passport_number": {
            "type": "string",
            "maxLength": 250
          },
          "recorded_status": {
            "type": "string",
            "maxLength": 250,
            "description": "User-supplied, unverified record value; not a government determination."
          },
          "accompanied_by": {
            "type": "string",
            "maxLength": 250
          },
          "valid_from": {
            "type": "string",
            "maxLength": 250,
            "description": "YYYY-MM-DD or empty string"
          },
          "valid_until": {
            "type": "string",
            "maxLength": 250,
            "description": "YYYY-MM-DD or empty string"
          },
          "entries_allowed": {
            "type": "string",
            "description": "Digits only (for example 1, 44, 777), Multiple (case-insensitive), or empty. Multiple is stored with this capitalization.",
            "maxLength": 250
          },
          "national_insurance_number": {
            "type": "string",
            "maxLength": 250
          },
          "phone_number": {
            "type": "string",
            "description": "Optional phone number containing 7\u201315 digits; +, spaces, parentheses, dots and dashes are accepted."
          }
        }
      },
      "ShareInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expires_in_hours": {
            "type": "integer",
            "minimum": 0,
            "maximum": 168,
            "default": 24,
            "description": "0 or omitted selects 24 hours"
          }
        }
      },
      "MessageInput": {
        "type": "object",
        "required": [
          "token",
          "recipient"
        ],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "recipient": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "VerifyInput": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "token"
            ],
            "additionalProperties": false,
            "properties": {
              "token": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "challenge_id",
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "challenge_id": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "pattern": "^[0-9]{6}$"
              }
            }
          }
        ]
      }
    }
  }
}
