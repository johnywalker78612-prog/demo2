# Generate actual secrets once: umask 077; go run ./cmd/server -init > .env
RECORDS_ADMIN_USERNAME=admin
RECORDS_ADMIN_EMAIL=
RECORDS_ADMIN_PASSWORD=
RECORDS_API_TOKEN=
RECORDS_DATA_KEY=
RECORDS_DATA_FILE=data/records.enc
RECORDS_ADDR=localhost:8081
RECORDS_SECURE_COOKIES=false

# Optional email delivery; blank host keeps development outbox mode.
RECORDS_PUBLIC_URL=http://localhost:8081
RECORDS_SMTP_HOST=
RECORDS_SMTP_PORT=587
RECORDS_SMTP_USERNAME=
RECORDS_SMTP_PASSWORD=
RECORDS_SMTP_FROM=
RECORDS_SMTP_IMPLICIT_TLS=false
# Optional Brevo transactional email API. When set, this takes priority over SMTP.
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=

# Optional logo image in Private Records emails; use your own public HTTPS PNG.
RECORDS_EMAIL_LOGO_URL=
