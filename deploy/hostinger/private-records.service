[Unit]
Description=Private Records web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=private-records
Group=private-records
WorkingDirectory=/opt/private-records
EnvironmentFile=/etc/private-records/app.env
ExecStart=/opt/private-records/server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
