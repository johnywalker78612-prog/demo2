{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/functions": "^0.11.0",
    "hono": "^4.13.20",
    "pg": "^8.23.1",
